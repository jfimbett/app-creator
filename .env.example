# App Creator root settings (all optional).
# To use them: copy this file to .env (`cp .env.example .env`) and edit the copy.
# The real .env is git-ignored. Never put real API keys in this example file.
# Values set in your terminal win over values in .env.

# Port for the Python backend (default 8000). Change it if `npm run dev` says the port is in use.
# BACKEND_PORT=8000

# Port for the web frontend (default 3000).
# FRONTEND_PORT=3000

# Exact Python (3.10 to 3.13) used to create the backend .venv, if the automatic search picks the wrong one.
# macOS/Linux example: APP_PYTHON=/opt/homebrew/bin/python3.12
# Windows example:     APP_PYTHON=C:\Users\you\AppData\Local\Programs\Python\Python312\python.exe
# APP_PYTHON=

# --- SEC Analytics example (examples/sec-analytics) ---

# Where the backend reads its data: "fixtures" (recorded SEC data, offline) or "live" (the Demo/Live selector is
# offered). The root commands set it: npm run demo uses fixtures, npm run dev uses live.
# DATA_MODE=fixtures

# Folder with the recorded SEC fixtures. Empty means examples/sec-analytics/fixtures.
# FIXTURES_DIR=

# A descriptive name plus your own contact email: `<app name> <your contact email>`. SEC requires this to identify
# automated requests. Each student uses their own. Needed for live mode and fixture capture. Never commit it.
# SEC_USER_AGENT=

# Disk cache for SEC responses, kept 24 hours. Empty means examples/sec-analytics/backend/.cache/sec (git-ignored).
# SEC_CACHE_DIR=

# Requests per second to SEC from this running app. Default 1; values above 5 are refused. SEC's limit of 10 per
# second is for all machines together, so a class on one public IP address should use Demo.
# SEC_MAX_REQUESTS_PER_SECOND=1
